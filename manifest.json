{
  "manifest_version": 3,
  "name": "LeetSync Personal",
  "version": "1.1.1",
  "description": "Push your accepted LeetCode submissions to your own GitHub repo. Authorizes through your own OAuth app, no third party.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*", "https://github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "LeetSync Personal", "default_popup": "options.html" }
}
